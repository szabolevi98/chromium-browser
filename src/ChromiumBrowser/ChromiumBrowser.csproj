<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChromiumBrowser</RootNamespace>
    <AssemblyName>ChromiumBrowser</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The source-generated P/Invokes for the window frame need this. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO1000 asks every public property of a control to say how the visual
         designer should serialise it. Nothing here is ever opened in the
         designer - the forms are code, with no .Designer.cs files - so the rule
         only adds attributes nobody reads. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- CefSharp ships its Chromium binaries as native runtime assets; naming
         the runtime is what flattens them beside the executable. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Without this the binaries land in a win-x64 folder inside the output,
         and the solution and the project disagree about where the program is.
         An hour was lost to running a stale copy. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <Version>2.1.0</Version>
    <Product>Chromium Browser</Product>
    <Company>szabolevi98</Company>
    <Copyright>Copyright (c) 2026 szabolevi98</Copyright>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="152.0.60" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChromiumBrowser.Core\ChromiumBrowser.Core.csproj" />
    <!-- The same icon again, as a resource: the one in the executable's header
         is what Explorer draws, and this is what the windows are given. -->
    <EmbeddedResource Include="Resources\app.ico" LogicalName="ChromiumBrowser.app.ico" />
  </ItemGroup>

</Project>
